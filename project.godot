[application]

config/name="VESSOUL (GodotSteam disabled)"
config/description="Steam Version
"
run/main_scene="uid://wxreufgqtrfd"
config/use_hidden_project_data_directory=false
config/use_custom_user_dir=true
config/custom_user_dir_name="VESSOUL"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://cubppusgrt1ha"
config/icon="uid://ci357wv0dxvct"

[audio]

buses/default_bus_layout="uid://ul8y7nsal2mf"

[autoload]

