config_version=5

[ResCleaner]

data/keep_list=Array[String](["res://abyss.tscn", "res://ascendants.tscn", "res://bunsoftsplash.png", "res://catacombs.tscn", "res://chasm.tscn", "res://clerestory.gd", "res://clerestory.tscn", "res://default_bus_layout.tres", "res://depths.tscn", "res://descent.tscn", "res://ending.tscn", "res://fonts/ModernDOS8x14.ttf", "res://fonts/ModernDOS8x8.ttf", "res://fonts/ModernDOS9x14.ttf", "res://fonts/ModernDOS9x16.ttf"])

[animation]

